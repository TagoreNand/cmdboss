# =============================================================================
# CMDBoss — Example environment configuration
# Copy to `.env` (auto-loaded in dev) or export these in your deployment.
# Every variable is prefixed CMDBOSS_ and overrides config.json.
# =============================================================================

# --- Service ---
CMDBOSS_ENVIRONMENT=development
CMDBOSS_HOST=0.0.0.0
CMDBOSS_PORT=8000

# --- MongoDB ---
CMDBOSS_MONGO_URI=mongodb://localhost:27017
CMDBOSS_DB_NAME=cmdboss

# --- Logging / metrics ---
CMDBOSS_LOG_LEVEL=INFO
CMDBOSS_LOG_JSON=true
CMDBOSS_METRICS_ENABLED=true

# --- Security ---
# Keep auth ON in any shared/deployed environment.
CMDBOSS_AUTH_ENABLED=true
# On first startup, if no API keys exist, this value is registered as an admin key.
# Generate a strong random value and rotate it after creating real keys.
CMDBOSS_BOOTSTRAP_ADMIN_KEY=change-me-to-a-long-random-secret
# Comma-separated list (or JSON array). Never use "*" in production.
CMDBOSS_CORS_ORIGINS=http://localhost:3000

# --- Registry / pagination tuning ---
CMDBOSS_SCHEMA_CACHE_TTL_SECONDS=5
CMDBOSS_DEFAULT_PAGE_SIZE=50
CMDBOSS_MAX_PAGE_SIZE=500
